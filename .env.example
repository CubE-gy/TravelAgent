# Copy this file to .env and replace each password before starting Docker Compose.
APP_ENV=development
TRAVEL_AGENT_DEV_DB_PASSWORD=change-me
TRAVEL_AGENT_TEST_DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://travel_agent_dev:change-me@127.0.0.1:5434/travel_agent_dev
TEST_DATABASE_URL=postgresql+psycopg://travel_agent_test:change-me@127.0.0.1:5435/travel_agent_test
# Optional during development. Never commit a real key.
AMAP_WEB_API_KEY=
# Required for the opt-in real LLM smoke test. Never commit a real key.
LLM_PROVIDER=mock
LLM_API_KEY=
# Any OpenAI-compatible API base URL can be used here.
LLM_BASE_URL=https://api.yhlxj.ai/v1
LLM_MODEL=
